# Database
DATABASE_URL="postgresql://user:password@localhost:5432/swm_producer_portal"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# WordPress
WP_API_URL="https://stolenwatermedia.com/wp-json/wp/v2"
WP_APP_USER=""
WP_APP_PASSWORD=""

# Google Cloud Storage (for video uploads)
# GCS_BUCKET_NAME stays the existing multi-region bucket.
# GCS_UPLOAD_BUCKET_NAME is the regional bucket for new objects. Leave it
# empty until that bucket exists. See docs/cloudrun-video-processing.md.
GCS_BUCKET_NAME=""
GCS_UPLOAD_BUCKET_NAME=""
GOOGLE_APPLICATION_CREDENTIALS=""

# Video processing runtime. Default is railway (in-process). Set cloudrun
# only after the Cloud Run job and invoker key exist.
VIDEO_PROCESSING_RUNTIME="railway"
CLOUD_RUN_JOB=""
CLOUD_RUN_INVOKER_CREDENTIALS_JSON=""

# Email Notifications (Resend)
RESEND_API_KEY=""

# Transcription (Deepgram)
DEEPGRAM_API_KEY=""

# Live-broadcast "mark that" scans. Default is on when unset. Set to "false"
# to stop the cron from transcribing newly archived recordings. An admin
# Re-scan on one recording still runs.
LIVE_TRANSCRIPTION_ENABLED="true"

# AI Processing (Anthropic Claude)
ANTHROPIC_API_KEY=""

# Job Processing (shared secret for cron/webhook access)
JOB_PROCESSING_SECRET=""

# Rate limiting for login / password reset (optional — falls back to
# per-instance memory when unset). Same Upstash instance as analytics cache.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Local seed script only (prisma/seed.ts refuses to run in production).
# Leave empty to generate random passwords, shown once when accounts are created.
SEED_ADMIN_PASSWORD=""
SEED_PRODUCER_PASSWORD=""
